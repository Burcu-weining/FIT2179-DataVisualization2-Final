{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Actual Rainfall vs Normal Rainfall",
    "fontSize": 18,
    "anchor": "start"
  },
  "width": 700,
  "height": 420,
  "data": {
    "url": "data/state_rainfall_summary.csv"
  },
  "mark": {
    "type": "circle",
    "size": 130,
    "opacity": 0.8,
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "avg_normal_rainfall_mm",
      "type": "quantitative",
      "title": "Normal rainfall"
    },
    "y": {
      "field": "avg_rainfall_mm",
      "type": "quantitative",
      "title": "Actual rainfall"
    },
    "color": {
      "field": "difference_from_normal",
      "type": "quantitative",
      "scale": {
        "scheme": "redblue"
      },
      "title": "Difference"
    },
    "tooltip": [
      {
        "field": "shapeISO",
        "type": "nominal"
      },
      {
        "field": "avg_rainfall_mm",
        "type": "quantitative",
        "format": ".2f"
      },
      {
        "field": "avg_normal_rainfall_mm",
        "type": "quantitative",
        "format": ".2f"
      },
      {
        "field": "difference_from_normal",
        "type": "quantitative",
        "format": ".2f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}