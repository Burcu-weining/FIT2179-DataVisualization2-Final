{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Flood Disasters Over the Years",
    "subtitle": "Yearly flood records show how flood occurrence changes over time.",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": 720,
  "height": 360,
  "data": {
    "url": "data/flood_yearly_clean.csv"
  },
  "mark": {
    "type": "line",
    "point": true,
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year"
    },
    "y": {
      "field": "flood_count",
      "type": "quantitative",
      "title": "Flood count"
    },
    "tooltip": [
      {"field": "year", "type": "ordinal", "title": "Year"},
      {"field": "flood_count", "type": "quantitative", "title": "Flood count"}
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}