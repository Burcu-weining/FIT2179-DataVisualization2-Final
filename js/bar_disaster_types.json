{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Types of Natural Disasters in Malaysia",
    "subtitle": "Floods are the most common disaster type in the dataset.",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": 720,
  "height": 380,
  "data": {
    "url": "data/disaster_type_clean.csv"
  },
  "mark": {
    "type": "bar",
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "count",
      "type": "quantitative",
      "title": "Recorded count"
    },
    "y": {
      "field": "disaster_type",
      "type": "nominal",
      "sort": "-x",
      "title": "Disaster type"
    },
    "color": {
      "field": "count",
      "type": "quantitative",
      "scale": {
        "scheme": "orangered"
      },
      "legend": null
    },
    "tooltip": [
      {"field": "disaster_type", "type": "nominal", "title": "Disaster type"},
      {"field": "count", "type": "quantitative", "title": "Count"}
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}