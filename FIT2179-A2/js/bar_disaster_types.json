{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Natural Disaster Types Recorded in Malaysia",
    "fontSize": 18,
    "anchor": "start"
  },
  "width": 720,
  "height": 380,
  "data": {
    "url": "data/disaster_type_summary.csv"
  },
  "mark": {
    "type": "bar",
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "count",
      "type": "quantitative",
      "title": "Count"
    },
    "y": {
      "field": "disaster_type",
      "type": "nominal",
      "sort": "-x",
      "title": "Disaster type"
    },
    "color": {
      "field": "count",
      "type": "quantitative",
      "scale": {
        "scheme": "orangered"
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "disaster_type",
        "type": "nominal"
      },
      {
        "field": "count",
        "type": "quantitative"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}