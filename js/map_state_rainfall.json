{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
      "text": "Average Rainfall by State in Malaysia",
      "subtitle": "Darker states show higher average rainfall.",
      "fontSize": 18,
      "subtitleFontSize": 12,
      "anchor": "start"
    },
    "width": 720,
    "height": 450,
    "data": {
      "url": "data/rainfall_state_summary_clean.csv"
    },
    "transform": [
      {
        "lookup": "state",
        "from": {
          "data": {
            "url": "data/malaysia_states_simple.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "key": "properties.name"
        },
        "as": "geo"
      }
    ],
    "projection": {
      "type": "mercator",
      "center": [109, 4],
      "scale": 1100
    },
    "mark": {
      "type": "geoshape",
      "stroke": "white",
      "strokeWidth": 0.8
    },
    "encoding": {
      "shape": {
        "field": "geo",
        "type": "geojson"
      },
      "color": {
        "field": "avg_rainfall_mm",
        "type": "quantitative",
        "title": "Avg rainfall",
        "scale": {
          "scheme": "blues"
        }
      },
      "tooltip": [
        {"field": "state", "type": "nominal", "title": "State"},
        {"field": "avg_rainfall_mm", "type": "quantitative", "title": "Average rainfall", "format": ".2f"}
      ]
    },
    "config": {
      "view": {
        "stroke": null
      }
    }
  }