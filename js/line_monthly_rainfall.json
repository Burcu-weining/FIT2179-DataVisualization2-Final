{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Average Monthly Rainfall in Malaysia",
    "subtitle": "Rainfall changes across the year, showing seasonal variation.",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": 720,
  "height": 360,
  "data": {
    "url": "data/rainfall_monthly_clean.csv"
  },
  "mark": {
    "type": "line",
    "point": true,
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "month_name",
      "type": "ordinal",
      "title": "Month",
      "sort": ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    },
    "y": {
      "field": "avg_rainfall_mm",
      "type": "quantitative",
      "title": "Average rainfall"
    },
    "tooltip": [
      {"field": "month_name", "type": "ordinal", "title": "Month"},
      {"field": "avg_rainfall_mm", "type": "quantitative", "title": "Average rainfall", "format": ".2f"}
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}